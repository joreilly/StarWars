# Shared by the Android and iOS apps: CI passes APP_ID with -e
appId: ${APP_ID}
---
- launchApp:
    clearState: true

# People and films come from the live GraphQL API, so allow for a slow network
- assertVisible: "Star Wars"
- extendedWaitUntil:
    visible: "Luke Skywalker"
    timeout: 30000

# The films tab is labelled differently on each platform
- runFlow:
    when:
      platform: Android
    commands:
      - tapOn: "Film List"
- runFlow:
    when:
      platform: iOS
    commands:
      - tapOn: "Films"
- extendedWaitUntil:
    visible: "A New Hope"
    timeout: 30000

- takeScreenshot: StarWars
